{
  "name": "@ui-restore/scanner",
  "version": "0.1.0",
  "description": "Scan Vue project components into an index",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuhujiang/ui-restore.git",
    "directory": "packages/scanner"
  },
  "homepage": "https://github.com/wuhujiang/ui-restore#readme",
  "bugs": {
    "url": "https://github.com/wuhujiang/ui-restore/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx/esm src/scan.test.ts"
  },
  "dependencies": {
    "@ui-restore/shared": "workspace:*",
    "@vue/compiler-sfc": "^3.5.17"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
