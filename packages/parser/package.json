{
  "name": "@ui-restore/parser",
  "version": "0.1.0",
  "description": "DSL validate, normalize, and shared-component extraction",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx/esm src/normalize.test.ts && node --import tsx/esm src/extract.test.ts"
  },
  "dependencies": {
    "@ui-restore/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
