{
  "name": "@ui-restore/cli",
  "version": "0.1.0",
  "description": "CLI for ui-restore — restore UI into your existing Vue project",
  "license": "MIT",
  "keywords": [
    "ui-restore",
    "vue",
    "vue3",
    "cli",
    "design-to-code",
    "dsl",
    "autofix"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuhujiang/ui-restore.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/wuhujiang/ui-restore#readme",
  "bugs": {
    "url": "https://github.com/wuhujiang/ui-restore/issues"
  },
  "type": "module",
  "bin": {
    "ui-restore": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx/esm src/config.test.ts && node --import tsx/esm src/init.test.ts && node --import tsx/esm src/commands/autofix.test.ts"
  },
  "dependencies": {
    "@ui-restore/autofix": "workspace:*",
    "@ui-restore/generator": "workspace:*",
    "@ui-restore/parser": "workspace:*",
    "@ui-restore/scanner": "workspace:*",
    "@ui-restore/shared": "workspace:*",
    "@ui-restore/vision": "workspace:*",
    "commander": "^14.0.0",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
